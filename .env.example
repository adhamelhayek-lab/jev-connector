# ==========================================
# JEV CONNECTOR - ENVIRONMENT CONFIGURATION
# ==========================================
#
# IMPORTANT:
# This is an EXAMPLE file.
# These keys are intentionally fake.
# NEVER put real API keys in GitHub.
# Real secrets will be added privately in Render.
# ==========================================


# ------------------------------------------
# Jev Connector API Authentication
# ------------------------------------------

JEV_API_KEY=jev_test_example_only


# ------------------------------------------
# Jev Model
# ------------------------------------------

JEV_MODEL=typesafe-ai/jev


# ------------------------------------------
# Shared Memory Service
# ------------------------------------------

MEMORY_API_URL=https://ai-shared-memory-lptw.onrender.com

MEMORY_API_KEY=memory_test_example_only


# ------------------------------------------
# Market Data
# ------------------------------------------

# Binance USD-M Futures public REST API
MARKET_DATA_BASE_URL=https://fapi.binance.com

# Binance USD-M Futures public WebSocket
MARKET_DATA_WS_URL=wss://fstream.binance.com/stream


# ------------------------------------------
# Trader Safety
# ------------------------------------------

# PAPER is the default.
TRADING_MODE=PAPER

# Must remain false until live trading
# has been deliberately enabled and tested.
LIVE_TRADING_ENABLED=false

# Emergency kill switch.
# true = immediately block trading.
TRADING_KILL_SWITCH=false


# ------------------------------------------
# CORS
# ------------------------------------------

# Leave empty for server-to-server operation.
# Add a frontend URL only if needed.
CORS_ORIGIN=


# ------------------------------------------
# Server Port
# ------------------------------------------

# Render automatically provides PORT.
# Do not normally set it manually.

# PORT=3000
